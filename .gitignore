# Credenciais e configuracao local - nunca versionar
.env

# Workers Python - rodam fora do container (host do a2teck), mas o
# codigo fica versionado. So excluir credenciais e artefatos gerados.
assets/python/.env
assets/python/*.pkl
assets/python/__pycache__/
assets/python/screenshots/
assets/python/chrome_profile_chamados/
assets/python/*_old*.py
assets/python/*teste*.py
assets/python/*.py_old

# Dumps e backups do banco - podem conter dados reais
assets/_db/*.sql
assets/_db/dados/

# Estudo de migracao para Vue - fora do escopo deste deploy
frontend/
docs/

# Artefatos locais / IDE
screenshots/
.claude/
*.log
*.log.*

# Dados de usuario reais - implantacao nova comeca vazia (volumes Docker)
uploads/
assets/img/produtos/
assets/arquivos/*.xlsx

# Artefatos de bug (Fix #5 atualizaAvarias, ver memoria) - fotos reais soltas
# no lugar errado, nao fazem parte do codigo da aplicacao
assets/7908871909886/
assets/QUEBRADO/

# Docker
docker/.env
