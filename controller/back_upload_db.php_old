function trataValor($va){
    $a = str_replace(".","", $va);
    $b = str_replace(",",".", $a);
    return $b;
}
function rmNegat($a){
    $b = str_replace(".","", $a);
    $c = str_replace(",",".", $b);
    $d = substr($c,-1);
    if ($d == "-"){
        $e = str_replace("-","", $c);
        $g = str_split($e);
        array_unshift($g, "-");
        $h = implode($g);
        $f = floatval($h);
    }else{
        $f = floatval($c);
    }
    return $f;
}
function pega($ii,$ff,$a){
    for ($i=$ii; $i < $ff; $i++) {
      //echo $a[$i]."<br>";
      $codigo[] = "$a[$i]";
      $imp = implode($codigo);
      //print_r ($imp);
    }
    return $imp;
}
function datadb($d){
    $n = explode('/',$d);
    $r = "$n[2]$n[1]$n[0]";
    return $r;
}
